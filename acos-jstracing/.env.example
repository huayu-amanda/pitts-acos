# Example environment variables for acos-jstracing
# Base URL of QuizPetAuthoring (no trailing slash)
QUIZPET_BASE_URL=http://localhost:8080/quizpet

# Optional service account credentials for QuizPetAuthoring (login to get JSESSIONID)
QUIZPET_USERNAME=testuser
QUIZPET_PASSWORD=testpass

# Optional per-exercise mapping: QUIZ_ID_<EXERCISE_NAME_UPPER>
# Example for exercise 'point_above_below' -> set QUIZ_ID_POINT_ABOVE_BELOW=1
# QUIZ_ID_POINT_ABOVE_BELOW=1

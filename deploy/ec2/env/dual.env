# Dual mode: local and pitts pages enabled together in one acos-server instance.
# Local source (/quizpet-generator) uses adminuser/testpass against in-stack QuizPet.
# Pitts source (/quizpet-generator-pitts) uses adl01/adl01 against adapt2.

# Global defaults (used by legacy flows)
QUIZPET_BASE_URL=http://quizpet-tomcat:8080/quizpet
QUIZPET_USERNAME=testuser
QUIZPET_PASSWORD=testpass

# Generator source A (local page: /quizpet-generator)
QUIZPET_BASE_URL_LOCAL=http://quizpet-tomcat:8080/quizpet
QUIZPET_USERNAME_LOCAL=
QUIZPET_PASSWORD_LOCAL=

# Generator source B (pitts page: /quizpet-generator-pitts)
QUIZPET_BASE_URL_PITTS=https://adapt2.sis.pitt.edu/quizpet_authoring
QUIZPET_USERNAME_PITTS=adl01
QUIZPET_PASSWORD_PITTS=adl01

# Admin account: adminuser for local QuizPet, adl01 for Pitt
QUIZPET_USERNAME_ADMIN=adminuser
QUIZPET_PASSWORD_ADMIN=testpass

# Student account: default user for quiz-taking pages
QUIZPET_USERNAME_STUDENT=testuser
QUIZPET_PASSWORD_STUDENT=testpass

# Optional existing vars used by compose
LTI_CONSUMER_KEY=acos
LTI_CONSUMER_SECRET=acos
MYSQL_ROOT_PASSWORD=rootpassword
